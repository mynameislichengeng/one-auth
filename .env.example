# 复制为 .env.local（dev）或 .env.prod（生产）并填入真实值
# .env.* 不进 git；进 git 的只有这份模板
#   cp .env.example .env.local
#
# 设计原则：本文件只放 (1) secret (2) 部署元信息（每个实例不同）(3) 运行模式分支
# 产品/环境固定决策都在 server/config/config.{env}.yaml hardcode，不绕这里
#
# 部署入口：
#   ./scripts/deploy-local.sh    # 本地蓝绿（首次→blue；二次→蓝绿切换）
#   ./scripts/deploy-prod.sh     # 生产蓝绿（需 .env.prod）

# ============ 运行环境 ============
# 决定后端加载 server/config/config.${APP_ENV}.yaml；启动时跟 yaml 顶部 env 字段自检
APP_ENV=local

# ============ 部署路径 ============
# 蓝绿 slot.conf / oneauth keys / mysql data 都挂在这下面
DATA_DIR=./docker/data

# 蓝绿排水等待秒数（local 默认 5；prod 默认 30）
# DRAIN_WAIT=5

# ============ 端口（host 侧暴露） ============
GATEWAY_HOST_PORT=80
MYSQL_HOST_PORT=3306
REDIS_HOST_PORT=6379

# ============ MySQL 容器 root 密码（仅 local 启 mysql 容器时用；prod 走云 RDS 不需要）============
MYSQL_ROOT_PASSWORD=root_dev_pwd_change_me

# ============ 应用连接信息 ============
# DB_HOST: local 不填 → docker-compose 默认注入 mysql（service name）；prod 必填 RDS endpoint
# DB_HOST=
DB_PASSWORD=oneauth_dev_pwd_change_me

# REDIS_ADDR: local 不填 → docker-compose 默认注入 redis:6379；prod 必填
# REDIS_ADDR=
REDIS_PASSWORD=

# ============ 部署元信息（每个公司部署值不同） ============
# JWT issuer: local 不填 → yaml hardcode oneauth-dev；prod 必填正式域名（如 https://auth.licheng.cn）
# JWT_ISSUER=

# OIDC discovery 用的对外 base URL；留空则从请求 Host 头推断；prod 必须显式
# PUBLIC_BASE_URL=

# ============ Bootstrap 平台超级管理员（首次启动创建） ============
# BOOTSTRAP_ADMIN_EMAIL: local 不填 → yaml hardcode admin@oneauth.local；prod 必填运维邮箱
# BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
