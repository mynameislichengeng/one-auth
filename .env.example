# 复制为 .env.local 并填入真实值；.env.* 不进 git（仅 .env.example 进 git）。
#   cp .env.example .env.local
#
# 部署入口：
#   ./scripts/deploy-local.sh    # 本地蓝绿（首次→blue；二次→蓝绿切换）
#   ./scripts/deploy-prod.sh     # 生产蓝绿（需 .env.prod）

# ============ 运行环境标识 ============
# 决定后端加载 server/config/config.${APP_ENV}.yaml
# 启动时跟 yaml 顶部 env 字段自检一致；本地默认 local，prod 部署传 prod
APP_ENV=local

# 数据目录（蓝绿 slot.conf 写入 ${DATA_DIR}/nginx/slot.conf；本地线上同结构）
DATA_DIR=./docker/data

# 蓝绿排水等待秒数（local 默认 5；prod 默认 30）
# DRAIN_WAIT=5

# MySQL
MYSQL_ROOT_PASSWORD=root_dev_pwd_change_me
MYSQL_HOST_PORT=3306

# 数据库
DB_NAME=oneauth
DB_USERNAME=oneauth
DB_PASSWORD=oneauth_dev_pwd_change_me

# Redis
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# 缓存驱动：memory | redis
CACHE_DRIVER=redis

# 端口
ONEAUTH_HOST_PORT=8080
GATEWAY_HOST_PORT=80

# JWT issuer 标识；生产期对应正式域名（如 https://auth.licheng.cn）
JWT_ISSUER=oneauth-dev
# OIDC discovery 用的对外 base URL；留空则从请求 Host 头推断
PUBLIC_BASE_URL=

# 自动 SQL 迁移开关（启动时跑 server/sql/update/ 下未执行的脚本）
MIGRATION_ENABLED=true

# Bootstrap 平台超级管理员（首次启动创建）
BOOTSTRAP_ADMIN_EMAIL=admin@oneauth.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
BOOTSTRAP_ADMIN_NICKNAME="Platform Admin"

# 日志
LOG_LEVEL=debug
LOG_FORMAT=text
