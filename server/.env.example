# 复制为 .env 并填入真实值；.env 不要进 git。

# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oneauth
DB_USERNAME=oneauth
DB_PASSWORD=oneauth_dev_pwd_change_me

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# 缓存驱动：memory | redis
CACHE_DRIVER=redis

# JWT 密钥路径（首次启动会自动生成 RSA 2048 密钥对到这里）
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ISSUER=oneauth-dev

# 服务监听
SERVER_LISTEN=:8080

# Bootstrap 平台超级管理员（首次启动创建，之后请改密）
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@oneauth.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
BOOTSTRAP_ADMIN_NICKNAME=Platform Admin

# 日志
LOG_LEVEL=debug
LOG_FORMAT=text
