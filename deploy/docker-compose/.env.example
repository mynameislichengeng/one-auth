# 复制为 .env 并填入真实值；.env 不要进 git。

# MySQL
MYSQL_ROOT_PASSWORD=root_dev_pwd_change_me
MYSQL_HOST_PORT=3306

# 数据库
DB_NAME=oneauth
DB_USERNAME=oneauth
DB_PASSWORD=oneauth_dev_pwd_change_me

# Redis
REDIS_PASSWORD=
REDIS_HOST_PORT=6379

# 缓存驱动：memory | redis
CACHE_DRIVER=redis

# oneauth-server 暴露端口
ONEAUTH_HOST_PORT=8080

# Bootstrap 平台超级管理员（首次启动创建）
BOOTSTRAP_ADMIN_EMAIL=admin@oneauth.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeOnFirstLogin!
BOOTSTRAP_ADMIN_NICKNAME=Platform Admin

# 日志
LOG_LEVEL=debug
LOG_FORMAT=text
